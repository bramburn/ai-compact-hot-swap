		"prepublishOnly": "npm run typecheck"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.85.0"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.0",
		"@types/node": "^22.19.0",
		"@typescript/native-preview": "7.0.0-dev.20260120.1"
	}
