{
	"name": "@bramburn/ai-compact-hot-swap",
	"version": "0.2.1",
	"description": "pi coding-agent extension: background compaction with hot-swap of the live context window",
	"license": "MIT",
	"type": "module",
	"main": "index.ts",
	"author": {
		"name": "bramburn",
		"url": "https://github.com/bramburn"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bramburn/ai-compact-hot-swap.git"
	},
	"bugs": {
		"url": "https://github.com/bramburn/ai-compact-hot-swap/issues"
	},
	"homepage": "https://github.com/bramburn/ai-compact-hot-swap#readme",
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-package",
		"compact",
		"compaction",
		"context",
		"context-window",
		"hot-swap",
		"background"
	],
	"publishConfig": {
		"access": "public"
	},
	"pi": {
